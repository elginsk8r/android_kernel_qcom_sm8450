load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load(":target_variants.bzl", "la_variants", "targets")

# The Motorola product is selected with
#   --//vendor/motorola/sm8450-kernel:mmi_product=<product>
# instead of a generated moto_product.bzl. A build setting can't be read while
# macros run, so everything product specific has to go through select().
#
# Products are discovered from the per-product defconfig fragments, which are
# named arch/arm64/configs/vendor/ext_config/moto-<msm_target>-<product>.config.

_EXT_CONFIG_DIR = "arch/arm64/configs/vendor/ext_config"

# moto-<msm_target>-<x>.config fragments that don't describe a product
_NON_PRODUCT_FRAGMENTS = la_variants + ["gki"]

def _fragment_path(msm_target, suffix = None):
    name = "moto-{}".format(msm_target)
    if suffix:
        name += "-" + suffix
    return "{}/{}.config".format(_EXT_CONFIG_DIR, name)

def _existing_fragment(msm_target, suffix = None):
    path = _fragment_path(msm_target, suffix)
    return path if native.glob([path], allow_empty = True) else None

def get_moto_products(msm_target):
    """Returns the Motorola products that have a defconfig fragment for msm_target."""
    prefix = "{}/moto-{}-".format(_EXT_CONFIG_DIR, msm_target)
    products = []
    for path in native.glob([_fragment_path(msm_target, "*")], allow_empty = True):
        product = path[len(prefix):-len(".config")]
        if product not in _NON_PRODUCT_FRAGMENTS:
            products.append(product)
    return products

def define_moto_product_flag():
    """Defines the mmi_product flag and a config_setting for every known product."""
    string_flag(
        name = "mmi_product",
        build_setting_default = "",
        visibility = ["//visibility:public"],
    )

    products = {}
    for msm_target in targets:
        for product in get_moto_products(msm_target):
            products[product] = True

    for product in products:
        native.config_setting(
            name = "mmi_product_{}".format(product),
            flag_values = {":mmi_product": product},
            visibility = ["//visibility:public"],
        )

def _apply_fragment_config(name, fragment):
    write_file(
        name = name,
        out = "{}.build.config".format(name),
        content = ["apply_defconfig_fragment ${KERNEL_DIR}/" + fragment, ""],
    )
    return ":" + name

def get_moto_build_configs(msm_target, target, variant):
    """Build config fragments applying the Motorola defconfig fragments.

    Same order as the moto_fragment.config generated by the vendor build:
    moto-<msm_target>, moto-<msm_target>-<product>, moto-<msm_target>-<variant>.
    Must be placed after build.config.msm.common, which resets DEFCONFIG_FRAGMENTS.

    Returns:
      A list (possibly containing a select()) to append to kernel_build_config.srcs
    """
    configs = []

    base = _existing_fragment(msm_target)
    if base:
        configs.append(_apply_fragment_config("{}_build_config_moto".format(target), base))

    product_configs = {"//conditions:default": []}
    for product in get_moto_products(msm_target):
        product_configs[":mmi_product_{}".format(product)] = [_apply_fragment_config(
            "{}_build_config_moto_{}".format(target, product),
            _fragment_path(msm_target, product),
        )]

    variant_fragment = _existing_fragment(msm_target, variant)
    variant_configs = []
    if variant_fragment:
        variant_configs.append(_apply_fragment_config(
            "{}_build_config_moto_{}".format(target, variant),
            variant_fragment,
        ))

    return configs + select(product_configs) + variant_configs

def define_moto_kernel_internal_headers():
    """Kernel internal headers included by the Motorola modules.

    The vendor build adds -I$(KERNEL_SRC) and -I$(KERNEL_SRC)/drivers/base for
    modules such as moto_binder, moto_sched, sx937x and awinic_sar.
    """
    ddk_headers(
        name = "moto_kernel_internal_headers",
        hdrs = native.glob([
            "drivers/android/*.h",
            "drivers/base/*.h",
            "kernel/*.h",
            "kernel/sched/*.h",
        ]),
        includes = [
            ".",
            "drivers/base",
        ],
        visibility = ["//visibility:public"],
    )

def moto_product_dict(msm_target, default, by_product):
    """Per-product values as a {config_setting: value} dict for select().

    Args:
      msm_target: name of target platform (e.g. "parrot")
      default: value without a (matching) product
      by_product: dict of product -> value

    Returns:
      None if no value is product specific, otherwise the dict.
    """
    if not by_product:
        return None

    products = get_moto_products(msm_target)
    ret = {"//conditions:default": default}
    for product, value in by_product.items():
        if product not in products:
            fail("{}: product {} has no moto-{}-{}.config".format(msm_target, product, msm_target, product))
        ret["//vendor/motorola/sm8450-kernel:mmi_product_{}".format(product)] = value
    return ret
